{
  "name": "bit101-error-reports",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "routes": [
    {
      "pattern": "feedback.aihelpme.dev",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ERROR_REPORTS",
      "id": "4c6402dfad4e406a93cc2518843803c6"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "REPORT_QUOTA", "class_name": "ReportQuota" }]
  },
  "migrations": [{ "tag": "report-quota", "new_sqlite_classes": ["ReportQuota"] }],
  "send_email": [
    {
      "name": "REPORT_EMAIL",
      "destination_address": "idleassetsd@gmail.com"
    }
  ]
}
